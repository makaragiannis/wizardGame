<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>


<BorderPane fx:id="myBorderPane" minHeight="700.0" minWidth="800.0" prefHeight="700.0" prefWidth="800.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="wizardGame.GameController">
   <center>
      <AnchorPane maxHeight="398.0" maxWidth="-Infinity" minHeight="350.0" minWidth="800.0" prefHeight="398.0" prefWidth="800.0" stylesheets="@style.css">
         <children>
            <Label fx:id="roundLabel" layoutX="24.0" layoutY="26.0" prefHeight="31.0" prefWidth="100.0" text="Round 1">
               <font>
                  <Font name="System Bold" size="21.0" />
               </font>
            </Label>
            <HBox id="centerCards" fx:id="centerCards" alignment="CENTER" layoutX="161.0" layoutY="134.0" onDragDropped="#dropCardAtCenter" onDragOver="#dragCardOverCenter" prefHeight="125.0" prefWidth="473.0" spacing="5.0" />
            <Button fx:id="orderCardsButton" layoutX="647.0" layoutY="172.0" mnemonicParsing="false" onAction="#orderHand" prefHeight="25.0" prefWidth="117.0" text="Order Cards" />
            <ChoiceBox fx:id="tricksChoiceBox" layoutX="634.0" layoutY="307.0" prefHeight="35.0" prefWidth="82.0" visible="false" />
            <Button fx:id="nextActionButton" layoutX="286.0" layoutY="305.0" mnemonicParsing="false" onAction="#nextAction" prefHeight="47.0" prefWidth="310.0" text="Next Action">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Button>
            <Label fx:id="leadColorLabel" layoutX="163.0" layoutY="103.0" prefHeight="17.0" prefWidth="79.0" text="Lead Color" />
            <Label fx:id="dealerLabel" layoutX="140.0" layoutY="34.0" text="Dealer: " />
            <Label fx:id="firstPlayerLabel" layoutX="138.0" layoutY="59.0" text="Now Playing:" />
            <Label fx:id="currentTrickWinnerLabel" layoutX="40.0" layoutY="289.0" text="Trick Winner:" />
            <Button fx:id="showPlayedCardsButton" layoutX="647.0" layoutY="134.0" mnemonicParsing="false" onAction="#showPlayedCards" text="Show Played Cards" />
            <Button fx:id="showAssumptionsButton" layoutX="647.0" layoutY="211.0" mnemonicParsing="false" onAction="#showAssumptions" text="Show Assumptions" />
            <HBox fx:id="trumpCardBox" alignment="CENTER" layoutX="24.0" layoutY="134.0" prefHeight="125.0" prefWidth="100.0" />
            <Label fx:id="trumpColorLabel" layoutX="35.0" layoutY="112.0" prefHeight="17.0" prefWidth="79.0" text="Trump Color" />
            <Label fx:id="lastActionLabel" layoutX="337.0" layoutY="68.0" prefHeight="30.0" prefWidth="427.0">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label fx:id="lastTrickWinnerLabel" layoutX="40.0" layoutY="311.0" text="Last Trick Winner:" />
         </children>
      </AnchorPane>
   </center>
   <top>
      <HBox fx:id="topPlayerInfoBox" alignment="CENTER" maxHeight="200.0" minHeight="136.0" minWidth="800.0" prefHeight="136.0" prefWidth="800.0" BorderPane.alignment="CENTER" />
   </top>
   <bottom>
      <HBox fx:id="player1Box" alignment="CENTER" maxHeight="140.0" minHeight="140.0" minWidth="800.0" prefHeight="140.0" prefWidth="800.0" spacing="10.0" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
